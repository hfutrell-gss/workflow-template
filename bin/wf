#!/usr/bin/env bash
# wf — check out a workflow and bind substrate targets.
#
# Usage:
#   wf <workflow> [target-repo ...]   # cd into the workflow, launch claude with each
#                                     # target granted via --add-dir (cloned if absent)
#   wf --list                         # list workflows
#   wf <workflow> ... --dry-run       # print the command instead of launching
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MANIFEST="$ROOT/manifest.yaml"
command -v yq >/dev/null || { echo "error: yq (mikefarah v4) is required — run /workflows-init (.claude/skills/workflows-init/init.sh) first" >&2; exit 1; }

base_raw="$(yq -r '.base' "$MANIFEST")"
BASE="${base_raw/#\~/$HOME}"

list_workflows() {
  find "$ROOT" -maxdepth 2 -mindepth 2 -name CLAUDE.md \
    | sed "s#^$ROOT/##; s#/CLAUDE.md##" | grep -v '^_' | sort
}

[ "$#" -ge 1 ] || { echo "usage: wf <workflow> [target-repo ...] | wf --list" >&2; exit 1; }
[ "$1" = "--list" ] && { list_workflows; exit 0; }

wfname="$1"; shift
WFDIR="$ROOT/$wfname"
[ -f "$WFDIR/CLAUDE.md" ] || { echo "error: unknown workflow '$wfname' (wf --list)" >&2; exit 1; }

# Parse --dry-run out of the arg list FIRST, in its own pass, before any target is
# looked at. A dry run must never have side effects (in particular: never `git clone`),
# and that only holds if `dry` is fully known before the target loop below runs — doing
# both in one pass let a --dry-run appearing after a target clone for real first.
dry=0
targets=()
for t in "$@"; do
  if [ "$t" = "--dry-run" ]; then dry=1; else targets+=("$t"); fi
done

args=()
for t in "${targets[@]+"${targets[@]}"}"; do
  case "$t" in
    /*) dir="$t" ;;                 # absolute path target: bind as-is
    *)  dir="$BASE/$t"
        if [ ! -e "$dir/.git" ]; then
          url="$(yq -r ".repos[] | select(.name == \"$t\") | .url" "$MANIFEST")"
          branch="$(yq -r ".repos[] | select(.name == \"$t\") | .branch" "$MANIFEST")"
          if [ -n "$url" ] && [ "$url" != "null" ]; then
            if [ "$dry" -eq 1 ]; then
              echo "would clone $t ($branch) from $url" >&2
            else
              echo "binding: cloning $t ($branch) into $BASE" >&2
              git clone --branch "$branch" "$url" "$dir" >&2
            fi
          elif [ ! -d "$dir" ]; then
            echo "error: target '$t' not on disk and not in manifest.yaml" >&2; exit 1
          fi
        fi ;;
  esac
  args+=(--add-dir "$dir")
done

# Trust the workflow dir so the session starts without the trust dialog (best-effort).
if command -v python3 >/dev/null && [ -f "$HOME/.claude.json" ]; then
  python3 - "$WFDIR" <<'PY' 2>/dev/null || true
import json, os, sys
p=os.path.expanduser("~/.claude.json"); key=sys.argv[1]
d=json.load(open(p)); e=d.setdefault("projects",{}).setdefault(key,{})
e.update({"hasTrustDialogAccepted":True,"hasClaudeMdExternalIncludesApproved":True,"hasClaudeMdExternalIncludesWarningShown":True})
tmp=p+".tmp"; json.dump(d,open(tmp,"w"),indent=2); os.replace(tmp,p)
PY
fi

if [ "$dry" -eq 1 ]; then
  printf 'cd %q && claude' "$WFDIR"
  [ "${#args[@]}" -gt 0 ] && printf ' %q' "${args[@]}"
  printf '\n'
  exit 0
fi
cd "$WFDIR"
exec claude "${args[@]+"${args[@]}"}"
